# copie pra .env e ajuste se quiser; a app roda sem nada disso
HTTP_TIMEOUT=15
CACHE_TTL=600
RATE_LIMIT=100/minute
# chaves de demo da propria API do Balcao (CSV): quem manda uma no header
# X-API-Key ou na query ?chave= ganha um balde de rate limit so seu, isolado
# do IP compartilhado. Vazio = todo mundo e anonimo (balde por IP).
API_KEYS=

# fontes com chave (cadastro gratis) — sem a chave, a fonte responde 503
# token: https://portaldatransparencia.gov.br/api-de-dados/cadastrar-email
TRANSPARENCIA_API_KEY=
# token: https://brapi.dev (dashboard)
BRAPI_TOKEN=
# chave PUBLICA do CNJ (rotaciona): datajud-wiki.cnj.jus.br/api-publica/acesso
DATAJUD_API_KEY=
